# アプリ基本設定
APP_NAME=Laravel-Order-API
APP_ENV=local
APP_KEY=  # php artisan key:generate で生成
APP_URL=http://localhost
APP_DEBUG=true

# DB接続（Docker構成と合わせる）
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_order_api
DB_USERNAME=root
DB_PASSWORD=root

# ログ＆メール（開発環境用: Mailtrapなどを利用）
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_NAME="Laravel Order System"

# セッションドライバ
SESSION_DRIVER=cookie
